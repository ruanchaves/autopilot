{
  "_comment": "Role-agnostic source catalogue, derived from an earlier private sweep catalogue. Search terms and title filters live in profiles/, never here.",
  "user_agent": "jobsweep/1.0 (personal job search)",
  "http": [
    {
      "id": "himalayas",
      "label": "Himalayas",
      "kind": "json",
      "url": "https://himalayas.app/jobs/api?limit=20",
      "items": "jobs",
      "map": {
        "title": "title",
        "company": "companyName",
        "location": "locationRestrictions",
        "url": "applicationLink",
        "posted": "pubDate"
      },
      "pagination": {
        "kind": "cursor",
        "param": "cursor",
        "cursor_at": "nextCursor",
        "pages": 60
      },
      "min_interval": 1,
      "_note": "The API ignores search/category parameters and caps limit at 20; it lists every category newest first (~3,700/day), so depth is the only lever. 60 pages ~= the last 5 hours; run it a few times a day."
    },
    {
      "id": "remoteok",
      "label": "Remote OK",
      "kind": "json",
      "url": "https://remoteok.com/api",
      "profile_params": {
        "tags": "remoteok_tags"
      },
      "items": "",
      "skip_first": 1,
      "map": {
        "title": "position",
        "company": "company",
        "location": "location",
        "url": "url",
        "posted": "date"
      },
      "attribution": "Job data by Remote OK",
      "min_interval": 10
    },
    {
      "id": "jobgether",
      "label": "Jobgether",
      "kind": "json",
      "url": "https://jobgether.com/astroapi/ai/jobs.json?limit=25",
      "items": "jobs",
      "map": {
        "title": "title",
        "company": "company",
        "location": "location",
        "url": "url",
        "posted": "postedAt"
      },
      "pagination": {
        "kind": "page",
        "param": "page",
        "start": 1,
        "pages": 4
      },
      "min_interval": 2
    },
    {
      "id": "workingnomads",
      "label": "Working Nomads",
      "kind": "json",
      "url": "https://www.workingnomads.com/api/exposed_jobs/",
