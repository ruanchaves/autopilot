{
  "_comment": "Role-agnostic source catalogue, derived from D:/dev/jobsearch/scripts/sources.yaml. Search terms and title filters live in profiles/, never here.",
  "user_agent": "jobsweep/1.0 (personal job search)",
  "http": [
    {
      "id": "himalayas",
      "label": "Himalayas",
      "kind": "json",
      "url": "https://himalayas.app/jobs/api?limit=20",
      "items": "jobs",
      "map": {
        "title": "title",
        "company": "companyName",
        "location": "locationRestrictions",
        "url": "applicationLink",
        "posted": "pubDate"
      },
      "pagination": {
        "kind": "cursor",
        "param": "cursor",
        "cursor_at": "nextCursor",
        "pages": 60
      },
      "min_interval": 1,
      "_note": "The API ignores search/category parameters and caps limit at 20; it lists every category newest first (~3,700/day), so depth is the only lever. 60 pages ~= the last 5 hours; run it a few times a day."
    },
    {
      "id": "remoteok",
      "label": "Remote OK",
      "kind": "json",
      "url": "https://remoteok.com/api",
      "profile_params": {
        "tags": "remoteok_tags"
      },
      "items": "",
      "skip_first": 1,
      "map": {
        "title": "position",
        "company": "company",
        "location": "location",
        "url": "url",
        "posted": "date"
      },
      "attribution": "Job data by Remote OK",
      "min_interval": 10
    },
    {
      "id": "jobgether",
      "label": "Jobgether",
      "kind": "json",
      "url": "https://jobgether.com/astroapi/ai/jobs.json?limit=25",
      "items": "jobs",
      "map": {
        "title": "title",
        "company": "company",
        "location": "location",
        "url": "url",
        "posted": "postedAt"
      },
      "pagination": {
        "kind": "page",
        "param": "page",
        "start": 1,
        "pages": 4
      },
      "min_interval": 2
    },
    {
      "id": "workingnomads",
      "label": "Working Nomads",
      "kind": "json",
      "url": "https://www.workingnomads.com/api/exposed_jobs/",
      "items": "",
      "map": {
        "title": "title",
        "company": "company_name",
        "location": "location",
        "url": "url",
        "posted": "pub_date"
      },
      "min_interval": 10
    },
    {
      "id": "remotive",
      "label": "Remotive",
      "kind": "rss",
      "url": "https://remotive.com/remote-jobs/feed",
      "map": {
        "company": "company"
      },
      "attribution": "Job data by Remotive",
      "_note": "Remotive asks for at most ~4 requests/day; data is ~24h delayed.",
      "min_interval": 60
    },
    {
      "id": "weworkremotely",
      "label": "We Work Remotely",
      "kind": "rss",
      "url": "https://weworkremotely.com/categories/remote-programming-jobs.rss",
      "rss_by_category": {
        "programming": "https://weworkremotely.com/categories/remote-programming-jobs.rss",
        "all": "https://weworkremotely.com/remote-jobs.rss"
      },
      "title_pattern": "^(?P<company>.+?):\\s*(?P<title>.+)$",
      "min_interval": 60
    },
    {
      "id": "nodesk",
      "label": "NoDesk",
      "kind": "rss",
      "url": "https://nodesk.co/remote-jobs/engineering/index.xml",
      "rss_by_category": {
        "engineering": "https://nodesk.co/remote-jobs/engineering/index.xml",
        "all": "https://nodesk.co/remote-jobs/index.xml"
      },
      "title_pattern": "^(?P<title>.+?)\\s+at\\s+(?P<company>.+)$",
      "min_interval": 60
    },
    {
      "id": "cryptocurrencyjobs",
      "label": "Cryptocurrency Jobs",
      "kind": "rss",
      "url": "https://cryptocurrencyjobs.co/index.xml",
      "title_pattern": "^(?P<title>.+?)\\s+at\\s+(?P<company>.+)$",
      "min_interval": 60
    },
    {
      "id": "hn_hiring",
      "label": "HN Who is hiring",
      "kind": "hn",
      "url": "https://hn.algolia.com/api/v1",
      "threads": 2,
      "pages": 3,
      "min_interval": 1,
      "_note": "Top-level comments of the newest 'Ask HN: Who is hiring?' threads via the public Algolia API. The first line 'Company | Role | Location | REMOTE' becomes company/title/location; url is the HN item, apply_url the first link in the post."
    },
    {
      "id": "yc_jobs",
      "label": "YC Work at a Startup",
      "kind": "yc",
      "url": "https://www.ycombinator.com/jobs",
      "role": "eng",
      "pages": 3,
      "min_interval": 1,
      "_note": "ycombinator.com/jobs is public and embeds the Work at a Startup results as Inertia data-page JSON (20 per page; query= and remote=yes work). The job url points at workatastartup.com."
    },
