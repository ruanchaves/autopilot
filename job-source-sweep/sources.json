    {
      "id": "cryptocurrencyjobs",
      "label": "Cryptocurrency Jobs",
      "kind": "rss",
      "url": "https://cryptocurrencyjobs.co/index.xml",
      "title_pattern": "^(?P<title>.+?)\\s+at\\s+(?P<company>.+)$",
      "min_interval": 60,
      "sector": "web3",
      "_note": "Site-wide RSS (every category, ~50 newest posts); the title filter keeps the on-role ones. The /ai/ category page is relevance-sorted and months stale (checked 2026-10-15), so the feed stays. sector: web3 marks its rows for the autopilot's pay estimate (web3 pays global USD)."
    },
    {
      "id": "web3career",
      "label": "Web3 Jobs",
      "kind": "web3career",
      "url": "https://web3.career",
      "pages": [
        "/ai-jobs?remote=true",
        "/machine-learning-jobs?remote=true"
      ],
      "page_count": 2,
      "sector": "web3",
      "min_interval": 3,
      "_note": "web3.career's category pages, server-rendered (checked 2026-10-15): 15 rows per page with the posting's own date, company, location and pay; 'Estimated salary' figures are dropped. The JSON API needs an emailed token, which the HTML makes unnecessary. Earlier this host was only reached through a Google site: shard, which found one role in three weeks."
    },
    {
      "id": "hn_hiring",
      "label": "HN Who is hiring",
      "kind": "hn",
      "url": "https://hn.algolia.com/api/v1",
      "threads": 2,
      "pages": 3,
      "min_interval": 1,
      "_note": "Top-level comments of the newest 'Ask HN: Who is hiring?' threads via the public Algolia API. The first line is conventionally 'Company | Role | Location | REMOTE | ...'. Posts land all month long (2026-10-15: 2 of 179 on-role posts were inside a 2-day window, 90 inside 30 days), so the source keeps its own window_days; merge honours it and the autopilot queue never drops a role inside it.",
      "window_days": 35
    },
    {
      "id": "yc_jobs",
      "label": "YC Work at a Startup",
      "kind": "yc",
      "url": "https://www.ycombinator.com",
      "pages": [
        "/jobs?role=eng&remote=yes",
        "/jobs/role/software-engineer",
        "/jobs/role/software-engineer/remote",
        "/jobs/role/ai-engineer",
        "/jobs/role/machine-learning-engineer",
        "/jobs/location/remote"
      ],
      "waas": "https://www.workatastartup.com/jobs?role=eng&remote=yes",
      "window_days": 45,
      "min_interval": 1,
      "_note": "Public pages that embed Work at a Startup postings as Inertia data-page JSON. Checked 2026-10-15: ycombinator.com/jobs ignores query, page and remote and always embeds the same 20 featured jobs; each /jobs/role/<slug>[/remote] page embeds a fixed sample of ~30; the anonymous workatastartup.com/jobs page 30 more (no dates). The fetcher merges all of them. The full search (~2,900 engineering jobs) is behind a free Work at a Startup account: browser task yc_waas (plan.json) in the user's signed-in Chrome. YC postings stay open for months, hence window_days."
    },
