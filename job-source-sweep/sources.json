  "getro": {
    "url": "https://api.getro.com/api/v2/collections/{network_id}/search/jobs",
    "_note": "POST only. Accept must be exactly application/json or it answers 406. hitsPerPage is ignored (always 20). All networks share one host, so requests are serialised. Networks are listed US-first so a tight --budget cuts the European boards, not these. 2 pages x 20 per query is plenty inside a 2-day window.",
    "pages": 2,
    "min_interval": 2
  },
